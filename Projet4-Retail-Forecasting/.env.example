# Copier en .env puis compléter : cp .env.example .env
# .env est gitignore — ne jamais committer de credentials.

# --- AWS (Learner Lab : "AWS Details" -> credentials, valables ~4 h) ---
AWS_REGION=us-east-1
SAGEMAKER_ROLE_ARN=arn:aws:iam::<ACCOUNT_ID>:role/LabRole
S3_BUCKET=retail-forecast-<account>-<binome>
# Réutilise le profil ~/.aws/credentials si vide
AWS_PROFILE=

# --- ingestion ---
INGEST_BACKEND=kafka            # kafka | kinesis | batch
KAFKA_BOOTSTRAP=localhost:19092
KAFKA_TOPIC=sales.events

# --- ML ---
FORECAST_HORIZON=28
MODEL_NAME=lgbm-global
WAPE_THRESHOLD=0.30

# --- LLM / agent (bedrock | jumpstart | ollama) ---
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
