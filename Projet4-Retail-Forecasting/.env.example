# Copier en .env puis compléter : cp .env.example .env
# .env est gitignore — ne jamais committer de credentials.

# --- AWS (Learner Lab : "AWS Details" -> credentials, valables ~4 h) ---
AWS_REGION=us-east-1
SAGEMAKER_ROLE_ARN=arn:aws:iam::<ACCOUNT_ID>:role/LabRole
# En local (MinIO) : retail-forecast-local. Sur AWS : retail-forecast-<account>-<binome>
S3_BUCKET=retail-forecast-local
# Réutilise le profil ~/.aws/credentials s'il est renseigné (laisser commenté sinon)
# AWS_PROFILE=

# --- stockage objet : S3 local (s3mock) en dev, S3 sur AWS ---
# Laisser S3_ENDPOINT_URL vide pour utiliser AWS S3 (credentials du Learner Lab).
S3_ENDPOINT_URL=http://localhost:9090
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- ingestion ---
INGEST_BACKEND=kafka            # kafka | kinesis | batch
KAFKA_BOOTSTRAP=localhost:19092
KAFKA_TOPIC=sales.events

# --- ML ---
FORECAST_HORIZON=28
MODEL_NAME=lgbm-global
WAPE_THRESHOLD=0.45

# --- LLM / agent (bedrock | jumpstart | ollama) ---
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
